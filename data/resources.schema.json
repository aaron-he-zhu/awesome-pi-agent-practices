{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awesome-pi-agent-practices:resources-schema:1",
  "title": "Awesome Pi Agent Practices resource registry",
  "type": "object",
  "required": ["schemaVersion", "snapshotAt", "baseline", "resources"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseline": {
      "type": "object",
      "required": ["piVersion", "piCommit", "mainCommit"],
      "additionalProperties": false,
      "properties": {
        "piVersion": {
          "type": "string"
        },
        "piCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "mainCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "reviewStatus",
          "url",
          "license",
          "currentScope",
          "lastReviewed",
          "piVersion",
          "platforms",
          "tests",
          "ci",
          "reason",
          "riskSummary"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "community"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "reviewedRef": {}
              },
              "required": ["reviewedRef"]
            }
          }
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["official", "related-list", "community"]
          },
          "status": {
            "enum": [
              "primary",
              "discovery",
              "research",
              "related",
              "related-archived",
              "watchlist",
              "watchlist-data-access",
              "watchlist-data-egress",
              "watchlist-high-risk",
              "watchlist-privacy",
              "watchlist-trust-sensitive",
              "deferred",
              "featured",
              "stale",
              "rejected"
            ]
          },
          "reviewStatus": {
            "enum": [
              "catalog-only",
              "source-reviewed",
              "hands-on-verified",
              "collection-needs-item-review",
              "legacy-scope",
              "blocked"
            ]
          },
          "reviewedRef": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "currentScope": {
            "type": "boolean"
          },
          "lastReviewed": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "piVersion": {
            "type": "string",
            "minLength": 1
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "string",
            "minLength": 1
          },
          "ci": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "riskSummary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
