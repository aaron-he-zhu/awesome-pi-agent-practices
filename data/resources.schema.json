{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awesome-pi-agent-practices:resources-schema:1",
  "title": "Awesome Pi Agent Practices resource registry",
  "type": "object",
  "required": ["schemaVersion", "snapshotAt", "baseline", "resources"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseline": {
      "type": "object",
      "required": ["piVersion", "piCommit", "mainCommit"],
      "additionalProperties": false,
      "properties": {
        "piVersion": {
          "type": "string",
          "pattern": "\\S"
        },
        "piCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "mainCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "status",
          "reviewStatus",
          "url",
          "license",
          "currentScope",
          "lastReviewed",
          "piVersion",
          "platforms",
          "tests",
          "ci",
          "reason",
          "riskSummary"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": ["related-list", "community"]
                }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "reviewedRef": {}
              },
              "required": ["reviewedRef"]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "official"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "status": {
                  "enum": ["primary", "discovery", "research"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "related-list"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "status": {
                  "enum": ["related", "related-archived", "rejected"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "community"
                }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "status": {
                  "enum": [
                    "watchlist",
                    "watchlist-data-access",
                    "watchlist-data-egress",
                    "watchlist-high-risk",
                    "watchlist-privacy",
                    "watchlist-trust-sensitive",
                    "deferred",
                    "featured",
                    "stale",
                    "rejected"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "watchlist",
                    "watchlist-data-access",
                    "watchlist-data-egress",
                    "watchlist-high-risk",
                    "watchlist-privacy",
                    "watchlist-trust-sensitive"
                  ]
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "reviewStatus": {
                  "enum": ["source-reviewed", "hands-on-verified"]
                },
                "currentScope": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "featured"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "community"
                },
                "reviewStatus": {
                  "const": "hands-on-verified"
                },
                "currentScope": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reviewStatus": {
                  "const": "hands-on-verified"
                }
              },
              "required": ["reviewStatus"]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "community"
                },
                "status": {
                  "enum": [
                    "watchlist",
                    "watchlist-data-access",
                    "watchlist-data-egress",
                    "watchlist-high-risk",
                    "watchlist-privacy",
                    "watchlist-trust-sensitive",
                    "featured",
                    "stale",
                    "rejected"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reviewStatus": {
                  "const": "catalog-only"
                }
              },
              "required": ["reviewStatus"]
            },
            "then": {
              "properties": {
                "status": {
                  "enum": ["discovery", "deferred", "rejected"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reviewStatus": {
                  "enum": ["collection-needs-item-review", "legacy-scope", "blocked"]
                }
              },
              "required": ["reviewStatus"]
            },
            "then": {
              "properties": {
                "status": {
                  "enum": ["deferred", "rejected"]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": ["primary", "discovery", "research", "related"]
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "currentScope": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "related-archived"
                }
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "currentScope": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reviewStatus": {
                  "const": "legacy-scope"
                }
              },
              "required": ["reviewStatus"]
            },
            "then": {
              "properties": {
                "currentScope": {
                  "const": false
                }
              }
            }
          }
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "kind": {
            "enum": ["official", "related-list", "community"]
          },
          "status": {
            "enum": [
              "primary",
              "discovery",
              "research",
              "related",
              "related-archived",
              "watchlist",
              "watchlist-data-access",
              "watchlist-data-egress",
              "watchlist-high-risk",
              "watchlist-privacy",
              "watchlist-trust-sensitive",
              "deferred",
              "featured",
              "stale",
              "rejected"
            ]
          },
          "reviewStatus": {
            "enum": [
              "catalog-only",
              "source-reviewed",
              "hands-on-verified",
              "collection-needs-item-review",
              "legacy-scope",
              "blocked"
            ]
          },
          "reviewedRef": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/?#\\s]+(?:[/?#]|$)"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "currentScope": {
            "type": "boolean"
          },
          "lastReviewed": {
            "type": "string",
            "format": "date"
          },
          "piVersion": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "platforms": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "tests": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "ci": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "riskSummary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
