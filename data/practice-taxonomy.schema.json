{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awesome-pi-agent-practices:practice-taxonomy-schema:1",
  "title": "Awesome Pi Agent Practices machine-readable taxonomy",
  "type": "object",
  "required": ["schemaVersion", "categories", "architectures", "relations"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taxonomyItem"
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taxonomyItem"
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/taxonomyItem"
      }
    }
  },
  "$defs": {
    "localizedLabel": {
      "type": "object",
      "required": ["en", "zh-CN"],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "taxonomyItem": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/localizedLabel"
        }
      }
    }
  }
}
