{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awesome-pi-agent-practices:discovery-queries-schema:1",
  "title": "Awesome Pi Agent Practices scheduled discovery queries",
  "type": "object",
  "required": ["$schema", "schemaVersion", "queries"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "./discovery-queries.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["id", "endpoint", "query", "sort", "order", "page", "perPage", "rationale"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "endpoint": {
            "enum": ["repositories", "code"]
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sort": {
            "oneOf": [
              { "enum": ["updated", "stars", "forks", "indexed"] },
              { "type": "null" }
            ]
          },
          "order": {
            "enum": ["asc", "desc"]
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
